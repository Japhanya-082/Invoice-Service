# Invoice-Service environment variables.
#
# Copy to .env and fill in. `.env` is gitignored — never commit the filled-in
# copy, and never give any variable below a default in a properties file.
#
# The MANDATORY block has no defaults in application*.properties. An unset
# variable fails startup with "Could not resolve placeholder" rather than
# silently falling back to a committed credential. The OPTIONAL block does
# have defaults, listed alongside; set them only to override.

# --- MANDATORY -------------------------------------------------------------

# Application database (application-{dev,prod,uatl}.properties).
DB_PASSWORD=

# SMTP password.
MAIL_PASSWORD=

# JWT signing key. Must match the JWT_SECRET used by every other service that
# validates these tokens: Invoice-Login, Invoice-Customer-Service,
# Invoice-Dashboard, Invoice-Reports-service, Invoice-Gateway.
JWT_SECRET=

# --- OPTIONAL --------------------------------------------------------------

# Database user.                          default: postgres
DB_USERNAME=

# SMTP sender.                            default: no-reply@singularanalysts.com
MAIL_USERNAME=

# Shared secret for the X-Internal-Api-Key header on /internal/** routes. The
# default is deliberately empty: isTrustedInternalCall() fails closed on a
# blank value, so internal calls are refused until a real key is set here.
# Never commit a real value.
INTERNAL_API_KEY=

# JWT claim validation. Every consumer checks these on each request, so a
# token minted for another issuer or audience is rejected even when its
# signature is valid. Change them only in lockstep across all services.
#                                         default: invoice-login
JWT_ISSUER=
#                                         default: invoice-platform
JWT_AUDIENCE=
#                                         default: 30
JWT_CLOCK_SKEW_SECONDS=

# Tenant routing (G-57). With the default, a token that has an adminId but no
# companyDomain is refused with 503 instead of being served from the shared
# default schema, which exposed every tenant's invoices. Set false only during
# an incident, and know that other tenants' rows are reachable while it is off.
# Users whose user_info.company_domain is null get 503 on every call; count
# them before deploying.
#                                         default: true
TENANT_REQUIRE_TENANT=

# Internal service addressing (Docker DNS on the `invoice` network).
#                                         default: http://customer:5679
CUSTOMER_SERVICE_URL=
#                                         default: http://login:5678
LOGIN_SERVICE_URL=

# Filesystem path the service writes uploaded files to.
#                                         default: /var/www/html/Invoice_BE/uploads
UPLOAD_DIR=
